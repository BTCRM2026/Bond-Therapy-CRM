generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum PortalType {
  ADMIN
  STAFF
  DISTRIBUTOR
}

enum Department {
  PURCHASE
  SALES
  ACCOUNTS_BILLING
  WAREHOUSE
  DEMO
}

enum DataScope {
  OWN
  TEAM
  DEPARTMENT
  COMPANY
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

model User {
  id                  String         @id @default(cuid())
  loginId             String         @unique
  email               String         @unique
  name                String
  passwordHash        String
  status              UserStatus     @default(ACTIVE)
  failedLoginAttempts Int            @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  department          Department?
  dataScope           DataScope      @default(OWN)
  managerId           String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  roles               UserRole[]
  sessions            Session[]
  auditLogs           AuditLog[]     @relation("AuditActor")
  notifications       Notification[] @relation("NotificationRecipient")
  distributors        Distributor[]  @relation("DistributorSalesperson")
  manager             User?          @relation("StaffManager", fields: [managerId], references: [id], onDelete: SetNull)
  teamMembers         User[]         @relation("StaffManager")
  staffProfile        StaffProfile?
  clientsCreated      Client[]         @relation("ClientCreator")
  clientsAssigned     Client[]         @relation("ClientSalesperson")
  clientsTrained      Client[]         @relation("ClientTrainer")
  clientActivities    ClientActivity[] @relation("ClientActivityCreator")

  @@index([department])
  @@index([managerId])
}

model StaffProfile {
  userId                 String         @id
  employeeCode           String         @unique
  mobile                 String
  jobTitle               String
  employmentType         EmploymentType @default(FULL_TIME)
  joiningDate            DateTime
  dateOfBirth            DateTime?
  shiftStart             String?
  shiftEnd               String?
  bloodGroup             BloodGroup?
  workLocation           String?
  residentialAddress     String?
  emergencyContactName   String?
  emergencyContactMobile String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  user                   User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([mobile])
}

model EmployeeCounter {
  key        String   @id
  nextNumber Int
  updatedAt  DateTime @updatedAt
}

model Role {
  id            String           @id @default(cuid())
  key           String           @unique
  name          String
  description   String?
  portal        PortalType
  dashboardPath String
  priority      Int              @default(100)
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  users         UserRole[]
  permissions   RolePermission[]

  @@index([portal, isActive])
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  module      String
  action      String
  description String?
  roles       RolePermission[]
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Session {
  id         String     @id
  userId     String
  portal     PortalType
  expiresAt  DateTime
  createdAt  DateTime   @default(now())
  lastSeenAt DateTime   @default(now())
  ipAddress  String?
  userAgent  String?
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([portal, expiresAt])
  @@index([expiresAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
}

enum DistributorStatus {
  ONBOARDING
  ACTIVE
  INACTIVE
}

model Distributor {
  id                    String            @id @default(cuid())
  businessName          String
  contactName           String
  phone                 String?
  email                 String?
  territory             String?
  creditLimit           Decimal?          @db.Decimal(12, 2)
  status                DistributorStatus @default(ONBOARDING)
  assignedSalespersonId String?
  assignedSalesperson   User?             @relation("DistributorSalesperson", fields: [assignedSalespersonId], references: [id], onDelete: SetNull)
  notes                 String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  agreements            Agreement[]
  clients               Client[]

  @@index([assignedSalespersonId])
  @@index([status])
}

enum ClientCategory {
  SALON
  SPA
  STUDIO
  ACADEMY
}

enum ClientStatus {
  PROSPECT
  ACTIVE
  INACTIVE
}

enum ClientPotential {
  HIGH
  MEDIUM
  LOW
}

enum CustomerSegment {
  PREMIUM
  MID
  VALUE
}

enum ClientActivityType {
  VISIT
  FOLLOW_UP
  DEMO
  SAMPLE
  NOTE
}

enum ClientActivityStatus {
  OPEN
  COMPLETED
  CANCELLED
}

model Client {
  id                       String           @id @default(cuid())
  salonName                String
  category                 ClientCategory
  status                   ClientStatus     @default(PROSPECT)
  ownerName                String?
  managerName              String?
  primaryContact           String
  whatsappNumber           String?
  email                    String?
  keyProfessional          String?
  fullAddress              String?
  area                     String?
  city                     String
  pincode                  String?
  googleMapsUrl            String?
  chairCount               Int?
  staffCount               Int?
  stylistCount             Int?
  approximateDailyCustomers Int?
  potential                ClientPotential?
  customerSegment          CustomerSegment?
  estimatedMonthlyBusiness Decimal?         @db.Decimal(12, 2)
  purchasingFrequency      String?
  territory                String?
  routeBeat                String?
  businessPotentialRating  Int?
  relationshipRating       Int?
  paymentBehaviourRating   Int?
  productOpportunityRating Int?
  overallRating            Int?
  assignedSalespersonId    String?
  assignedTrainerId        String?
  distributorId            String?
  createdById              String
  version                  Int              @default(1)
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  assignedSalesperson      User?            @relation("ClientSalesperson", fields: [assignedSalespersonId], references: [id], onDelete: SetNull)
  assignedTrainer          User?            @relation("ClientTrainer", fields: [assignedTrainerId], references: [id], onDelete: SetNull)
  distributor              Distributor?     @relation(fields: [distributorId], references: [id], onDelete: SetNull)
  createdBy                User             @relation("ClientCreator", fields: [createdById], references: [id], onDelete: Restrict)
  activities               ClientActivity[]

  @@index([assignedSalespersonId, status])
  @@index([assignedTrainerId, status])
  @@index([createdById])
  @@index([distributorId])
  @@index([city, area])
  @@index([salonName])
  @@index([primaryContact])
  @@index([updatedAt])
}

model ClientActivity {
  id          String               @id @default(cuid())
  clientId    String
  type        ClientActivityType
  status      ClientActivityStatus @default(OPEN)
  purpose     String?
  personMet   String?
  note        String?
  scheduledAt DateTime?
  completedAt DateTime?
  createdById String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  client      Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy   User                 @relation("ClientActivityCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([clientId, createdAt])
  @@index([clientId, status, scheduledAt])
  @@index([createdById])
}

enum AgreementPartyType {
  DISTRIBUTOR
  SUPPLIER
  EMPLOYEE
}

enum AgreementStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  TERMINATED
}

model Agreement {
  id            String             @id @default(cuid())
  partyType     AgreementPartyType
  partyName     String
  distributorId String?
  distributor   Distributor?       @relation(fields: [distributorId], references: [id], onDelete: SetNull)
  title         String
  signedDate    DateTime?
  expiryDate    DateTime?
  status        AgreementStatus    @default(ACTIVE)
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([distributorId])
  @@index([expiryDate])
  @@index([status])
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

model Notification {
  id          String               @id @default(cuid())
  type        String
  severity    NotificationSeverity @default(INFO)
  title       String
  message     String
  sourceKey   String               @unique
  portal      PortalType           @default(ADMIN)
  recipientId String?
  recipient   User?                @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  isRead      Boolean              @default(false)
  createdAt   DateTime             @default(now())

  @@index([isRead])
  @@index([type])
  @@index([recipientId, portal, isRead])
}

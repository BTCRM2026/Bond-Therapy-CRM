generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum PortalType {
  ADMIN
  STAFF
  DISTRIBUTOR
}

model User {
  id                  String      @id @default(cuid())
  loginId             String      @unique
  email               String      @unique
  name                String
  passwordHash        String
  status              UserStatus  @default(ACTIVE)
  failedLoginAttempts Int         @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  roles               UserRole[]
  sessions            Session[]
  auditLogs           AuditLog[]  @relation("AuditActor")
  distributors        Distributor[] @relation("DistributorSalesperson")
}

model Role {
  id            String           @id @default(cuid())
  key           String           @unique
  name          String
  description   String?
  portal        PortalType
  dashboardPath String
  priority      Int              @default(100)
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  users         UserRole[]
  permissions   RolePermission[]

  @@index([portal, isActive])
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  module      String
  action      String
  description String?
  roles       RolePermission[]
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Session {
  id         String   @id
  userId     String
  portal     PortalType
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  ipAddress  String?
  userAgent  String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([portal, expiresAt])
  @@index([expiresAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
}


enum DistributorStatus {
  ONBOARDING
  ACTIVE
  INACTIVE
}

model Distributor {
  id                    String            @id @default(cuid())
  businessName          String
  contactName           String
  phone                 String?
  email                 String?
  territory             String?
  creditLimit           Decimal?          @db.Decimal(12, 2)
  status                DistributorStatus @default(ONBOARDING)
  assignedSalespersonId String?
  assignedSalesperson   User?             @relation("DistributorSalesperson", fields: [assignedSalespersonId], references: [id], onDelete: SetNull)
  notes                 String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  agreements            Agreement[]

  @@index([assignedSalespersonId])
  @@index([status])
}

enum AgreementPartyType {
  DISTRIBUTOR
  SUPPLIER
  EMPLOYEE
}

enum AgreementStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  TERMINATED
}

model Agreement {
  id            String             @id @default(cuid())
  partyType     AgreementPartyType
  partyName     String
  distributorId String?
  distributor   Distributor?       @relation(fields: [distributorId], references: [id], onDelete: SetNull)
  title         String
  signedDate    DateTime?
  expiryDate    DateTime?
  status        AgreementStatus    @default(ACTIVE)
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([distributorId])
  @@index([expiryDate])
  @@index([status])
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

model Notification {
  id        String               @id @default(cuid())
  type      String
  severity  NotificationSeverity @default(INFO)
  title     String
  message   String
  sourceKey String               @unique
  isRead    Boolean              @default(false)
  createdAt DateTime             @default(now())

  @@index([isRead])
  @@index([type])
}

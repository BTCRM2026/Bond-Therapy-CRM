generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum PortalType {
  ADMIN
  STAFF
  DISTRIBUTOR
}

enum Department {
  PURCHASE
  SALES
  ACCOUNTS_BILLING
  WAREHOUSE
  DEMO
}

enum DataScope {
  OWN
  TEAM
  DEPARTMENT
  COMPANY
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

model User {
  id                       String               @id @default(cuid())
  loginId                  String               @unique
  email                    String               @unique
  name                     String
  passwordHash             String
  status                   UserStatus           @default(ACTIVE)
  failedLoginAttempts      Int                  @default(0)
  lockedUntil              DateTime?
  lastLoginAt              DateTime?
  department               Department?
  dataScope                DataScope            @default(OWN)
  managerId                String?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  roles                    UserRole[]
  sessions                 Session[]
  auditLogs                AuditLog[]           @relation("AuditActor")
  notifications            Notification[]       @relation("NotificationRecipient")
  distributors             Distributor[]        @relation("DistributorSalesperson")
  manager                  User?                @relation("StaffManager", fields: [managerId], references: [id], onDelete: SetNull)
  teamMembers              User[]               @relation("StaffManager")
  staffProfile             StaffProfile?
  clientsCreated           Client[]             @relation("ClientCreator")
  clientsAssigned          Client[]             @relation("ClientSalesperson")
  clientsTrained           Client[]             @relation("ClientTrainer")
  clientActivities         ClientActivity[]     @relation("ClientActivityCreator")
  clientActivitiesAssigned ClientActivity[]     @relation("ClientActivityAssignee")
  leadsAssigned            Lead[]               @relation("LeadAssignee")
  leadsCreated             Lead[]               @relation("LeadCreator")
  ordersBooked             Order[]              @relation("OrderSalesperson")
  ordersReviewed           Order[]              @relation("OrderReviewer")
  invoicesGenerated        Invoice[]            @relation("InvoiceGenerator")
  paymentsRecorded         Payment[]            @relation("PaymentRecorder")
  billingSettingsUpdated   BillingSettings[]    @relation("BillingSettingsUpdater")
  salesTargets             SalesTarget[]        @relation("SalesTargetOwner")
  stockMovementsRecorded   StockMovement[]      @relation("StockMovementRecorder")
  attendanceRecords        AttendanceRecord[]   @relation("AttendanceOwner")
  incentiveStatements      IncentiveStatement[] @relation("IncentiveOwner")
  incentivesApproved       IncentiveStatement[] @relation("IncentiveApprover")
  beatsAssigned            Beat[]               @relation("BeatAssignedStaff")
  territoryAssignments     TerritoryAssignment[] @relation("TerritoryAssignmentStaff")
  territoryAssignmentsMade TerritoryAssignment[] @relation("TerritoryAssignmentCreator")
  routes                   Route[]              @relation("RouteStaff")
  routeChangesMade         RouteChangeLog[]     @relation("RouteChangeActor")
  targetsCreated           Target[]             @relation("TargetCreator")
  incentiveRulesCreated    IncentiveRule[]       @relation("IncentiveRuleCreator")
  incentiveCalculations    IncentiveCalculation[] @relation("IncentiveCalcOwner")
  incentiveCalcsApproved   IncentiveCalculation[] @relation("IncentiveCalcApprover")
  operationsSettingsUpdated OperationsSettings[] @relation("OperationsSettingsUpdater")
  holidaysCreated          Holiday[]            @relation("HolidayCreator")
  leaveRequests            LeaveRequest[]       @relation("LeaveOwner")
  leaveReviewed            LeaveRequest[]       @relation("LeaveReviewer")
  correctionRequests       AttendanceCorrectionRequest[] @relation("CorrectionOwner")
  correctionsReviewed      AttendanceCorrectionRequest[] @relation("CorrectionReviewer")

  @@index([department])
  @@index([managerId])
}

model StaffProfile {
  userId                 String         @id
  employeeCode           String         @unique
  mobile                 String
  jobTitle               String
  employmentType         EmploymentType @default(FULL_TIME)
  joiningDate            DateTime
  dateOfBirth            DateTime?
  shiftStart             String?
  shiftEnd               String?
  bloodGroup             BloodGroup?
  workLocation           String?
  residentialAddress     String?
  emergencyContactName   String?
  emergencyContactMobile String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  user                   User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([mobile])
}

model EmployeeCounter {
  key        String   @id
  nextNumber Int
  updatedAt  DateTime @updatedAt
}

model Role {
  id            String           @id @default(cuid())
  key           String           @unique
  name          String
  description   String?
  portal        PortalType
  dashboardPath String
  priority      Int              @default(100)
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  users         UserRole[]
  permissions   RolePermission[]

  @@index([portal, isActive])
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  module      String
  action      String
  description String?
  roles       RolePermission[]
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Session {
  id         String     @id
  userId     String
  portal     PortalType
  expiresAt  DateTime
  createdAt  DateTime   @default(now())
  lastSeenAt DateTime   @default(now())
  ipAddress  String?
  userAgent  String?
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([portal, expiresAt])
  @@index([expiresAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
}

enum DistributorStatus {
  ONBOARDING
  ACTIVE
  INACTIVE
}

model Distributor {
  id                    String            @id @default(cuid())
  businessName          String
  contactName           String
  phone                 String?
  email                 String?
  territory             String?
  creditLimit           Decimal?          @db.Decimal(12, 2)
  status                DistributorStatus @default(ONBOARDING)
  assignedSalespersonId String?
  assignedSalesperson   User?             @relation("DistributorSalesperson", fields: [assignedSalespersonId], references: [id], onDelete: SetNull)
  notes                 String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  agreements            Agreement[]
  clients               Client[]

  @@index([assignedSalespersonId])
  @@index([status])
}

enum ClientCategory {
  SALON
  SPA
  STUDIO
  ACADEMY
}

enum ClientStatus {
  PROSPECT
  ACTIVE
  INACTIVE
}

enum ClientPotential {
  HIGH
  MEDIUM
  LOW
}

enum CustomerSegment {
  PREMIUM
  MID
  VALUE
}

enum ClientActivityType {
  VISIT
  FOLLOW_UP
  DEMO
  SAMPLE
  NOTE
}

enum ClientActivityStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum DemoOutcome {
  INTERESTED
  TRIAL_REQUIRED
  QUOTATION_REQUESTED
  NOT_INTERESTED
  FOLLOW_UP_REQUIRED
}

model Client {
  id                        String           @id @default(cuid())
  salonName                 String
  category                  ClientCategory
  status                    ClientStatus     @default(PROSPECT)
  ownerName                 String?
  managerName               String?
  primaryContact            String
  whatsappNumber            String?
  email                     String?
  keyProfessional           String?
  fullAddress               String?
  billingName               String?
  gstin                     String?
  state                     String?
  stateCode                 String?
  area                      String?
  city                      String
  pincode                   String?
  googleMapsUrl             String?
  latitude                  Decimal?         @db.Decimal(9, 6)
  longitude                 Decimal?         @db.Decimal(9, 6)
  chairCount                Int?
  staffCount                Int?
  stylistCount              Int?
  approximateDailyCustomers Int?
  potential                 ClientPotential?
  customerSegment           CustomerSegment?
  estimatedMonthlyBusiness  Decimal?         @db.Decimal(12, 2)
  purchasingFrequency       String?
  territory                 String?
  routeBeat                 String?
  beatId                    String?
  beat                      Beat?            @relation(fields: [beatId], references: [id], onDelete: SetNull)
  businessPotentialRating   Int?
  relationshipRating        Int?
  paymentBehaviourRating    Int?
  productOpportunityRating  Int?
  overallRating             Int?
  assignedSalespersonId     String?
  assignedTrainerId         String?
  distributorId             String?
  createdById               String
  version                   Int              @default(1)
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt
  assignedSalesperson       User?            @relation("ClientSalesperson", fields: [assignedSalespersonId], references: [id], onDelete: SetNull)
  assignedTrainer           User?            @relation("ClientTrainer", fields: [assignedTrainerId], references: [id], onDelete: SetNull)
  distributor               Distributor?     @relation(fields: [distributorId], references: [id], onDelete: SetNull)
  createdBy                 User             @relation("ClientCreator", fields: [createdById], references: [id], onDelete: Restrict)
  activities                ClientActivity[]
  leadSource                Lead?            @relation("LeadConversion")
  orders                    Order[]
  invoices                  Invoice[]
  routeStops                RouteStop[]

  @@index([assignedSalespersonId, status])
  @@index([assignedTrainerId, status])
  @@index([createdById])
  @@index([distributorId])
  @@index([city, area])
  @@index([salonName])
  @@index([primaryContact])
  @@index([updatedAt])
  @@index([beatId])
}

enum VisitOutcome {
  PRODUCTIVE
  ORDER_GENERATED
  QUOTATION_REQUIRED
  FOLLOW_UP_REQUIRED
  OWNER_UNAVAILABLE
  CLOSED
  NOT_INTERESTED
  RESCHEDULED
  OTHER
}

model ClientActivity {
  id                String               @id @default(cuid())
  clientId          String
  type              ClientActivityType
  status            ClientActivityStatus @default(OPEN)
  purpose           String?
  personMet         String?
  note              String?
  scheduledAt       DateTime?
  completedAt       DateTime?
  createdById       String
  assignedToId      String?
  attendeeCount     Int?
  requestedProducts Json?
  outcome           DemoOutcome?
  routeStopId       String?              @unique
  checkInAt         DateTime?
  checkOutAt        DateTime?
  visitOutcome      VisitOutcome?
  sampleGiven       Boolean              @default(false)
  nextAction        String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  client            Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy         User                 @relation("ClientActivityCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo        User?                @relation("ClientActivityAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  routeStop         RouteStop?           @relation(fields: [routeStopId], references: [id], onDelete: SetNull)
  visitProof        VisitProof?

  @@index([clientId, createdAt])
  @@index([clientId, status, scheduledAt])
  @@index([assignedToId, type])
  @@index([createdById])
}

model VisitProof {
  id               String         @id @default(cuid())
  activityId       String         @unique
  activity         ClientActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  checkInPhoto     Bytes
  checkInPhotoMime String
  checkInLatitude  Decimal        @db.Decimal(9, 6)
  checkInLongitude Decimal        @db.Decimal(9, 6)
  distanceMeters   Int?
  gpsVerified      Boolean?
  capturedAt       DateTime       @default(now())

  @@index([gpsVerified, capturedAt])
}

enum LeadSource {
  WEBSITE
  WHATSAPP
  INSTAGRAM
  CALL
  REFERRAL
  EXHIBITION
  WALK_IN
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

model Lead {
  id                String     @id @default(cuid())
  salonName         String
  contactName       String?
  phone             String
  whatsappNumber    String?
  city              String?
  area              String?
  source            LeadSource @default(OTHER)
  status            LeadStatus @default(NEW)
  notes             String?
  lostReason        String?
  nextActionAt      DateTime?
  assignedToId      String
  assignedTo        User       @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  convertedClientId String?    @unique
  convertedClient   Client?    @relation("LeadConversion", fields: [convertedClientId], references: [id], onDelete: SetNull)
  createdById       String
  createdBy         User       @relation("LeadCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([assignedToId, status])
  @@index([status, nextActionAt])
  @@index([phone])
}

enum ProductCategory {
  SHAMPOO
  CONDITIONER
  MASK
  TREATMENT
  KIT
  COLOR
  DEVELOPER
  STYLING
  OIL_SERUM
  LIQUID
  TOOLS
  OTHER
}

model Product {
  id           String          @id @default(cuid())
  sku          String          @unique
  name         String
  category     ProductCategory @default(OTHER)
  variant      String?
  unit         String          @default("pcs")
  unitPrice    Decimal         @db.Decimal(12, 2)
  hsnCode      String?
  gstRate      Decimal?        @db.Decimal(5, 2)
  stockOnHand  Int             @default(0)
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  orderItems   OrderItem[]
  invoiceItems InvoiceItem[]
  movements    StockMovement[]

  @@index([isActive])
  @@index([category])
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  RETURNED_FOR_CORRECTION
  APPROVED
  REJECTED
  INVOICE_GENERATED
  STOCK_RESERVED
  PICKING
  PACKED
  READY_FOR_DISPATCH
  OUT_FOR_DELIVERY
  ARRIVED_AT_CUSTOMER
  CONFIRMED
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum DeliveryMode {
  VADODARA_LOCAL
  OUTSTATION_COURIER
}

model Order {
  id                   String          @id @default(cuid())
  orderNumber          String          @unique
  clientId             String
  client               Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  salespersonId        String
  salesperson          User            @relation("OrderSalesperson", fields: [salespersonId], references: [id], onDelete: Restrict)
  status               OrderStatus     @default(DRAFT)
  subtotal             Decimal         @db.Decimal(12, 2)
  discountAmount       Decimal         @default(0) @db.Decimal(12, 2)
  taxableAmount        Decimal         @default(0) @db.Decimal(12, 2)
  taxRate              Decimal         @default(0) @db.Decimal(5, 2)
  taxAmount            Decimal         @default(0) @db.Decimal(12, 2)
  cgstAmount           Decimal         @default(0) @db.Decimal(12, 2)
  sgstAmount           Decimal         @default(0) @db.Decimal(12, 2)
  igstAmount           Decimal         @default(0) @db.Decimal(12, 2)
  totalAmount          Decimal         @db.Decimal(12, 2)
  notes                String?
  reviewComment        String?
  reviewedById         String?
  reviewedBy           User?           @relation("OrderReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  submittedAt          DateTime?
  reviewStartedAt      DateTime?
  returnedAt           DateTime?
  rejectedAt           DateTime?
  approvedAt           DateTime?
  stockReservedAt      DateTime?
  pickingStartedAt     DateTime?
  packedAt             DateTime?
  readyForDispatchAt   DateTime?
  deliveryMode         DeliveryMode?
  deliveryPersonName   String?
  deliveryPersonMobile String?
  courierName          String?
  trackingNumber       String?
  dispatchedAt         DateTime?
  outForDeliveryAt     DateTime?
  arrivedAt            DateTime?
  deliveredAt          DateTime?
  version              Int             @default(1)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  items                OrderItem[]
  stockMovements       StockMovement[]
  invoice              Invoice?
  deliveryProof        DeliveryProof?

  @@index([clientId])
  @@index([salespersonId, createdAt])
  @@index([status])
  @@index([reviewedById])
}

model DeliveryProof {
  id                String   @id @default(cuid())
  orderId           String   @unique
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  arrivalPhoto      Bytes?
  arrivalPhotoMime  String?
  deliveryPhoto     Bytes?
  deliveryPhotoMime String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

enum StockMovementType {
  RECEIVED
  ADJUSTMENT
  RETURNED
  DAMAGED
}

model StockMovement {
  id             String            @id @default(cuid())
  productId      String
  product        Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  type           StockMovementType
  quantityChange Int
  reason         String?
  orderId        String?
  order          Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  recordedById   String
  recordedBy     User              @relation("StockMovementRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  createdAt      DateTime          @default(now())

  @@index([productId, createdAt])
  @@index([type])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity       Int
  unitPrice      Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  taxableAmount  Decimal @default(0) @db.Decimal(12, 2)
  gstRate        Decimal @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal @default(0) @db.Decimal(12, 2)
  lineTotal      Decimal @db.Decimal(12, 2)

  @@index([orderId])
  @@index([productId])
}

enum InvoiceStatus {
  GENERATED
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum PaymentMode {
  CASH
  BANK_TRANSFER
  UPI
  CHEQUE
  CARD
  OTHER
}

model BillingSettings {
  id                      String   @id @default("default")
  legalName               String   @default("Bond Therapy")
  tradeName               String   @default("Bond Therapy Professional")
  gstin                   String?
  pan                     String?
  registeredAddress       String?
  city                    String?
  state                   String?
  stateCode               String?
  pincode                 String?
  phone                   String?
  email                   String?
  website                 String?
  bankName                String?
  accountName             String?
  accountNumber           String?
  ifsc                    String?
  branch                  String?
  upiId                   String?
  invoicePrefix           String   @default("BT")
  defaultGstRate          Decimal  @default(18) @db.Decimal(5, 2)
  defaultPaymentTermsDays Int      @default(30)
  allowSalesDiscount      Boolean  @default(false)
  maxSalesDiscountPercent Decimal  @default(0) @db.Decimal(5, 2)
  invoiceTerms            String?
  footerNote              String?
  logo                    Bytes?
  logoMime                String?
  signature               Bytes?
  signatureMime           String?
  accountManagerName      String?
  accountManagerTitle     String?  @default("Account Manager")
  updatedById             String?
  updatedBy               User?    @relation("BillingSettingsUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model Invoice {
  id               String        @id @default(cuid())
  invoiceNumber    String        @unique
  orderId          String        @unique
  order            Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  clientId         String
  client           Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  status           InvoiceStatus @default(GENERATED)
  companySnapshot  Json
  customerSnapshot Json
  subtotal         Decimal       @db.Decimal(12, 2)
  discountAmount   Decimal       @default(0) @db.Decimal(12, 2)
  taxableAmount    Decimal       @db.Decimal(12, 2)
  cgstAmount       Decimal       @default(0) @db.Decimal(12, 2)
  sgstAmount       Decimal       @default(0) @db.Decimal(12, 2)
  igstAmount       Decimal       @default(0) @db.Decimal(12, 2)
  taxAmount        Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount      Decimal       @db.Decimal(12, 2)
  amountPaid       Decimal       @default(0) @db.Decimal(12, 2)
  balanceDue       Decimal       @db.Decimal(12, 2)
  issuedAt         DateTime      @default(now())
  dueDate          DateTime
  sentAt           DateTime?
  paidAt           DateTime?
  generatedById    String
  generatedBy      User          @relation("InvoiceGenerator", fields: [generatedById], references: [id], onDelete: Restrict)
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  items            InvoiceItem[]
  payments         Payment[]

  @@index([clientId, issuedAt])
  @@index([status, dueDate])
  @@index([generatedById])
}

model InvoiceItem {
  id             String   @id @default(cuid())
  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  sku            String
  productName    String
  hsnCode        String?
  unit           String
  quantity       Int
  unitPrice      Decimal  @db.Decimal(12, 2)
  discountAmount Decimal  @default(0) @db.Decimal(12, 2)
  taxableAmount  Decimal  @db.Decimal(12, 2)
  gstRate        Decimal  @db.Decimal(5, 2)
  taxAmount      Decimal  @db.Decimal(12, 2)
  lineTotal      Decimal  @db.Decimal(12, 2)

  @@index([invoiceId])
  @@index([productId])
}

model Payment {
  id           String      @id @default(cuid())
  invoiceId    String
  invoice      Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  paymentDate  DateTime    @db.Date
  amount       Decimal     @db.Decimal(12, 2)
  mode         PaymentMode
  reference    String?
  notes        String?
  recordedById String
  recordedBy   User        @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  createdAt    DateTime    @default(now())

  @@index([invoiceId, paymentDate])
  @@index([recordedById])
}

model SalesTarget {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation("SalesTargetOwner", fields: [userId], references: [id], onDelete: Cascade)
  periodMonth  Int
  periodYear   Int
  targetAmount Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, periodYear, periodMonth])
  @@index([periodYear, periodMonth])
}

enum IncentiveStatus {
  PENDING
  APPROVED
  PAID
}

model IncentiveStatement {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation("IncentiveOwner", fields: [userId], references: [id], onDelete: Cascade)
  periodMonth     Int
  periodYear      Int
  ratePercent     Decimal         @db.Decimal(5, 2)
  eligibleRevenue Decimal         @db.Decimal(12, 2)
  incentiveAmount Decimal         @db.Decimal(12, 2)
  status          IncentiveStatus @default(PENDING)
  approvedById    String?
  approvedBy      User?           @relation("IncentiveApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([userId, periodYear, periodMonth])
  @@index([periodYear, periodMonth])
  @@index([status])
}

model AttendanceRecord {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation("AttendanceOwner", fields: [userId], references: [id], onDelete: Cascade)
  date               DateTime  @db.Date
  punchInAt          DateTime?
  punchOutAt         DateTime?
  punchInLatitude    Decimal?  @db.Decimal(9, 6)
  punchInLongitude   Decimal?  @db.Decimal(9, 6)
  punchOutLatitude   Decimal?  @db.Decimal(9, 6)
  punchOutLongitude  Decimal?  @db.Decimal(9, 6)
  punchInVerified    Boolean?
  punchOutVerified   Boolean?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

model OperationsSettings {
  id                    String   @id @default("default")
  officeLatitude        Decimal? @db.Decimal(9, 6)
  officeLongitude       Decimal? @db.Decimal(9, 6)
  officeRadiusMeters    Int?
  visitRadiusMeters     Int      @default(150)
  lateThresholdMinutes  Int      @default(15)
  halfDayThresholdHours Decimal  @default(4) @db.Decimal(4, 2)
  weeklyOffDays         Json     @default("[0]")
  updatedById           String?
  updatedBy             User?    @relation("OperationsSettingsUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt             DateTime @updatedAt
}

model Holiday {
  id          String   @id @default(cuid())
  date        DateTime @unique @db.Date
  name        String
  createdById String
  createdBy   User     @relation("HolidayCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LeaveRequest {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation("LeaveOwner", fields: [userId], references: [id], onDelete: Cascade)
  startDate    DateTime    @db.Date
  endDate      DateTime    @db.Date
  reason       String
  status       LeaveStatus @default(PENDING)
  reviewedById String?
  reviewedBy   User?       @relation("LeaveReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([userId, status])
  @@index([startDate, endDate])
}

model AttendanceCorrectionRequest {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation("CorrectionOwner", fields: [userId], references: [id], onDelete: Cascade)
  date              DateTime         @db.Date
  requestedPunchIn  DateTime?
  requestedPunchOut DateTime?
  reason            String
  status            CorrectionStatus @default(PENDING)
  reviewedById      String?
  reviewedBy        User?            @relation("CorrectionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt        DateTime?
  reviewNote        String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([userId, status])
}

enum AgreementPartyType {
  DISTRIBUTOR
  SUPPLIER
  EMPLOYEE
}

enum AgreementStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  TERMINATED
}

model Agreement {
  id            String             @id @default(cuid())
  partyType     AgreementPartyType
  partyName     String
  distributorId String?
  distributor   Distributor?       @relation(fields: [distributorId], references: [id], onDelete: SetNull)
  title         String
  signedDate    DateTime?
  expiryDate    DateTime?
  status        AgreementStatus    @default(ACTIVE)
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([distributorId])
  @@index([expiryDate])
  @@index([status])
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

model Region {
  id          String      @id @default(cuid())
  name        String      @unique
  code        String?     @unique
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  states      State[]
  territories Territory[]
}

model State {
  id          String      @id @default(cuid())
  name        String
  code        String?
  regionId    String
  region      Region      @relation(fields: [regionId], references: [id], onDelete: Restrict)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  cities      City[]
  territories Territory[]

  @@unique([regionId, name])
  @@unique([regionId, code])
  @@index([regionId])
}

model City {
  id          String      @id @default(cuid())
  name        String
  stateId     String
  state       State       @relation(fields: [stateId], references: [id], onDelete: Restrict)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  territories Territory[]
  areas       Area[]

  @@unique([stateId, name])
  @@index([stateId])
}

model Area {
  id          String      @id @default(cuid())
  name        String
  cityId      String
  city        City        @relation(fields: [cityId], references: [id], onDelete: Restrict)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  territories Territory[]

  @@unique([cityId, name])
  @@index([cityId])
}

model Territory {
  id        String   @id @default(cuid())
  name      String
  regionId  String
  region    Region   @relation(fields: [regionId], references: [id], onDelete: Restrict)
  stateId   String
  state     State    @relation(fields: [stateId], references: [id], onDelete: Restrict)
  cityId    String
  city      City     @relation(fields: [cityId], references: [id], onDelete: Restrict)
  areaId    String
  area      Area     @relation(fields: [areaId], references: [id], onDelete: Restrict)
  code      String?  @unique
  description String?
  effectiveFrom DateTime @default(now()) @db.Date
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  beats     Beat[]
  assignments TerritoryAssignment[]

  @@unique([areaId, name])
  @@index([regionId])
  @@index([stateId])
  @@index([cityId])
  @@index([areaId])
}

model TerritoryAssignment {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation("TerritoryAssignmentStaff", fields: [userId], references: [id], onDelete: Restrict)
  territoryId  String
  territory    Territory @relation(fields: [territoryId], references: [id], onDelete: Restrict)
  startDate    DateTime  @db.Date
  endDate      DateTime? @db.Date
  assignedById String?
  assignedBy   User?     @relation("TerritoryAssignmentCreator", fields: [assignedById], references: [id], onDelete: SetNull)
  reason       String?
  createdAt    DateTime  @default(now())

  @@index([userId, startDate])
  @@index([territoryId, startDate])
  @@index([endDate])
}

model Beat {
  id                 String    @id @default(cuid())
  name               String
  territoryId        String
  territory          Territory @relation(fields: [territoryId], references: [id], onDelete: Restrict)
  assignedStaffId    String?
  assignedStaff      User?     @relation("BeatAssignedStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  visitFrequencyDays Int?
  preferredVisitDays Json?
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  clients            Client[]

  @@unique([territoryId, name])
  @@index([territoryId])
  @@index([assignedStaffId])
}

enum RouteStatus {
  DRAFT
  PLANNED
  IN_PROGRESS
  PARTIALLY_COMPLETED
  COMPLETED
  CANCELLED
}

enum RouteStopStatus {
  PLANNED
  VISITED
  UNABLE_TO_MEET
  RESCHEDULED
  REMOVED
}

enum RouteChangeType {
  ADDED
  REMOVED
  REORDERED
  RESCHEDULED
  STATUS_CHANGE
}

model Route {
  id        String      @id @default(cuid())
  staffId   String
  staff     User        @relation("RouteStaff", fields: [staffId], references: [id], onDelete: Cascade)
  routeDate DateTime    @db.Date
  status    RouteStatus @default(DRAFT)
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  stops     RouteStop[]
  changes   RouteChangeLog[]

  @@unique([staffId, routeDate])
  @@index([staffId, routeDate])
  @@index([status])
}

model RouteStop {
  id          String          @id @default(cuid())
  routeId     String
  route       Route           @relation(fields: [routeId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  sequence    Int
  plannedTime DateTime?
  status      RouteStopStatus @default(PLANNED)
  note        String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  activity    ClientActivity?

  @@index([routeId])
  @@index([clientId])
}

model RouteChangeLog {
  id            String          @id @default(cuid())
  routeId       String
  route         Route           @relation(fields: [routeId], references: [id], onDelete: Cascade)
  changedById   String
  changedBy     User            @relation("RouteChangeActor", fields: [changedById], references: [id], onDelete: Restrict)
  changeType    RouteChangeType
  clientId      String?
  reason        String?
  previousValue Json?
  newValue      Json?
  createdAt     DateTime        @default(now())

  @@index([routeId, createdAt])
}

enum TargetScope {
  STAFF
  TERRITORY
  REGION
}

enum TargetMetric {
  REVENUE
  COLLECTION
  NEW_ACTIVE_SALONS
  VISITS
  PRODUCTIVE_VISITS
  CALLS
  FOLLOW_UPS
}

enum TargetPeriod {
  MONTHLY
  QUARTERLY
}

model Target {
  id          String       @id @default(cuid())
  scope       TargetScope
  scopeId     String
  metric      TargetMetric
  period      TargetPeriod
  periodYear  Int
  periodIndex Int
  targetValue Decimal      @db.Decimal(12, 2)
  createdById String
  createdBy   User         @relation("TargetCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([scope, scopeId, metric, period, periodYear, periodIndex])
  @@index([scope, scopeId])
  @@index([period, periodYear, periodIndex])
}

enum IncentiveSourceType {
  INVOICE
  PAYMENT
  ORDER
}

enum IncentiveCalcType {
  PERCENT
  FIXED
  SLAB
}

enum IncentiveRuleStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum IncentiveCalcStatus {
  CALCULATED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PAID
}

model IncentiveRule {
  id          String                 @id @default(cuid())
  name        String
  description String?
  createdById String
  createdBy   User                   @relation("IncentiveRuleCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  versions    IncentiveRuleVersion[]
}

model IncentiveRuleVersion {
  id                        String              @id @default(cuid())
  ruleId                    String
  rule                      IncentiveRule       @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  versionNumber             Int
  sourceType                IncentiveSourceType
  calcType                  IncentiveCalcType
  percent                   Decimal?            @db.Decimal(5, 2)
  fixedAmount               Decimal?            @db.Decimal(12, 2)
  slabs                     Json?
  roleEligibility           Json?
  territoryEligibility      Json?
  productCategoryEligibility Json?
  minThreshold              Decimal?            @db.Decimal(12, 2)
  maxThreshold              Decimal?            @db.Decimal(12, 2)
  effectiveFrom             DateTime
  effectiveUntil            DateTime?
  requiresApproval          Boolean             @default(true)
  status                    IncentiveRuleStatus @default(ACTIVE)
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  calculations              IncentiveCalculation[]

  @@unique([ruleId, versionNumber])
  @@index([ruleId])
}

model IncentiveCalculation {
  id             String               @id @default(cuid())
  ruleVersionId  String
  ruleVersion    IncentiveRuleVersion @relation(fields: [ruleVersionId], references: [id], onDelete: Restrict)
  userId         String
  user           User                 @relation("IncentiveCalcOwner", fields: [userId], references: [id], onDelete: Cascade)
  sourceType     IncentiveSourceType
  sourceId       String
  sourceReference String
  sourceDate     DateTime
  eligibleAmount Decimal              @db.Decimal(12, 2)
  calculation    Json
  incentiveAmount Decimal             @db.Decimal(12, 2)
  status         IncentiveCalcStatus  @default(PENDING_APPROVAL)
  approvedById   String?
  approvedBy     User?                @relation("IncentiveCalcApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt     DateTime?
  rejectedReason String?
  paidAt         DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([ruleVersionId, sourceType, sourceId])
  @@index([userId, status])
  @@index([ruleVersionId])
}

model Notification {
  id          String               @id @default(cuid())
  type        String
  severity    NotificationSeverity @default(INFO)
  title       String
  message     String
  sourceKey   String               @unique
  portal      PortalType           @default(ADMIN)
  recipientId String?
  recipient   User?                @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  isRead      Boolean              @default(false)
  createdAt   DateTime             @default(now())

  @@index([isRead])
  @@index([type])
  @@index([recipientId, portal, isRead])
}
